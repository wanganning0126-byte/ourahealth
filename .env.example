# Copy this file to .env and fill in your values:
#   cp .env.example .env

# From https://developer.ouraring.com (My Applications)
OURA_CLIENT_ID=your_client_id_here
OURA_CLIENT_SECRET=your_client_secret_here

# Must match exactly what you register in the Oura developer portal
OURA_REDIRECT_URI=http://localhost:8080/callback

# How many days of history to download (default: 365)
DAYS_BACK=365

# From https://platform.openai.com/api-keys — powers AI-generated insight text
# in the dashboard. Leave blank to skip AI insights (rule-based insights still work).
OPENAI_API_KEY=your_openai_api_key_here
